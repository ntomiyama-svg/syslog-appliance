# syslog-appliance 機器管理ファイル
#
# 配置先: /etc/syslog-appliance/devices.yaml
#
# このファイルはリポジトリ内の雛形（devices.yaml.example）を
# setup スクリプト（scripts/setup-mvp0.sh）が /etc/syslog-appliance/ へ
# .example を付けたままコピーします。
#
# ---------------------------------------------------------------------------
# MVP 0 での位置づけ
# ---------------------------------------------------------------------------
# このファイルは MVP 0 では読み込まれません（機能未実装）。
#
# MVP 1 以降で実装される以下の機能が、このファイルをデータソースとして使用します:
#   - Web UI でのログ検索・表示時に、IP アドレスを機器名・グループで絞り込む
#   - ログ一覧画面での「機器名」「ロケーション」列の表示
#   - グループ単位でのログ集計・レポート生成
#
# 今のうちにエントリを追加しておくことは構いませんが、
# MVP 0 の動作には影響しません。
# ---------------------------------------------------------------------------

# devices: 管理対象機器のリスト
# MVP 0 では空リストのままにしておいてください。
devices: []

# ---------------------------------------------------------------------------
# 将来のエントリ例（すべてコメントアウト）
# ---------------------------------------------------------------------------
# 実際に機器情報を登録する場合は、以下の形式を参考にしてください。
#
# devices:
#   - ip: 192.0.2.10
#     hostname: router-tokyo-01
#       # 機器の DNS ホスト名（任意）。設定しなくても動作します。
#     device_name: 本社ルーター
#       # 管理画面に表示する機器の名称（日本語可）
#     group: network
#       # 機器のグループ分類。検索・絞り込みに使用します。
#       # 推奨グループ名: network, server, security, facility, other
#     location: 本社サーバールーム
#       # 機器の設置場所（任意）
#     description: 本社メインルーター。障害時は NW 担当へ連絡。
#       # 備考・メモ（任意）
#
#   - ip: 192.0.2.20
#     hostname: sw-tokyo-core-01
#     device_name: 本社コアスイッチ
#     group: network
#     location: 本社サーバールーム
#
#   - ip: 10.0.1.50
#     hostname: fw-osaka-01
#     device_name: 大阪拠点ファイアウォール
#     group: security
#     location: 大阪拠点ラック
#
#   - ip: 10.0.1.100
#     hostname: server-osaka-01
#     device_name: 大阪拠点ファイルサーバー
#     group: server
#     location: 大阪拠点ラック
