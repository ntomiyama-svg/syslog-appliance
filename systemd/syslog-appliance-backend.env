# syslog-appliance バックエンド 環境変数設定ファイル
# このファイルを /etc/syslog-appliance/backend.env に配置して使用する。
#
# ⚠️  SYSLOG_APPLIANCE_AUTH_PASS は必ず手動で設定してください。
#     空のまま起動すると認証が機能せず、すべてのリクエストが拒否されます。

# SQLite データベースファイルのパス
SYSLOG_APPLIANCE_DB_PATH=/var/lib/syslog-appliance/db.sqlite

# appliance.conf のパス（参照のみ）
SYSLOG_APPLIANCE_CONFIG_PATH=/etc/syslog-appliance/appliance.conf

# Basic 認証のユーザー名
SYSLOG_APPLIANCE_AUTH_USER=admin

# Basic 認証のパスワード（⚠️ 必ず設定すること。空欄のままでは認証が機能しません）
SYSLOG_APPLIANCE_AUTH_PASS=

# ログレベル（DEBUG / INFO / WARNING / ERROR）
SYSLOG_APPLIANCE_LOG_LEVEL=INFO
